# Secrets: never commit
.env
*.key

# Dependencies and caches
node_modules/
__pycache__/
*.pyc
.DS_Store

# Working files (large, re-creatable)
projects/*/out/tmp/
projects/*/out/stills/
projects/*/audio/voice_raw.*
*.raw

# Company material stays on your computer (this repository is public)
brand/*
!brand/_template/
!brand/README.md
projects/*
!projects/_template/
!projects/README.md
references/**/*.mp4
references/**/*.mov
references/**/*.mp3
references/**/*.wav
